{
  "name": "@home-rpi/root",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace raiz del monorepo home-rpi (pnpm). Configuracion compartida minima; las apps se anaden en fases posteriores.",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.22.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "lint": "eslint .",
    "dev:menu": "pnpm --filter @home-rpi/menu-order-generator run start",
    "dev:vpn": "pnpm --filter @home-rpi/rpi-vpn-manager run start",
    "build:menu": "pnpm --filter @home-rpi/menu-order-generator run build",
    "build:vpn": "pnpm --filter @home-rpi/rpi-vpn-manager run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "typescript": "7.0.2"
  }
}
